@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Stats Row -->
<div class="row g-3">
    <!-- Category Stat -->
    <div class="col-md-3">
        <div class="card h-100 border-0 bg-info text-white shadow-sm" style="background-color: #00c0ef !important;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-subtitle text-white-50">DANH MỤC</h6>
                    <h2 class="card-title fw-bold mb-0">@ViewBag.CategoryCount</h2>
                </div>
                <i class="bi bi-tag fs-1 text-white-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="DhlCategory" asp-action="Index" class="text-white text-decoration-none small fw-semibold">
                    Xem chi tiết &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- Product Stat -->
    <div class="col-md-3">
        <div class="card h-100 border-0 text-white shadow-sm" style="background-color: #00a65a !important;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-subtitle text-white-50">SẢN PHẨM</h6>
                    <h2 class="card-title fw-bold mb-0">@ViewBag.ProductCount</h2>
                </div>
                <i class="bi bi-box fs-1 text-white-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="DhlProduct" asp-action="Index" class="text-white text-decoration-none small fw-semibold">
                    Xem chi tiết &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- Banner Stat -->
    <div class="col-md-3">
        <div class="card h-100 border-0 text-dark shadow-sm" style="background-color: #f39c12 !important;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-subtitle text-black-50">BANNER</h6>
                    <h2 class="card-title fw-bold mb-0">@ViewBag.BannerCount</h2>
                </div>
                <i class="bi bi-images fs-1 text-black-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="DhlBanner" asp-action="Index" class="text-dark text-decoration-none small fw-semibold">
                    Xem chi tiết &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- Blog Stat -->
    <div class="col-md-3">
        <div class="card h-100 border-0 text-white shadow-sm" style="background-color: #dd4b39 !important;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-subtitle text-white-50">BÀI VIẾT</h6>
                    <h2 class="card-title fw-bold mb-0">@ViewBag.BlogCount</h2>
                </div>
                <i class="bi bi-newspaper fs-1 text-white-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="DhlBlog" asp-action="Index" class="text-white text-decoration-none small fw-semibold">
                    Xem chi tiết &rarr;
                </a>
            </div>
        </div>
    </div>
</div>